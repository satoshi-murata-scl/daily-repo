AUTH_SECRET="change-this-to-a-long-random-string"
CRON_SECRET="change-this-for-cron-endpoint"
# 製作者用プロビジョニング（/maker）— 16文字以上のランダム文字列
MAKER_SECRET="change-this-maker-provisioning-secret"

